# =====================================
# Application
# =====================================
# Free-form name used in metadata and the UI.
NEXT_PUBLIC_SITE_NAME="Next.js Template"

# Canonical origin, without a trailing slash. Drives canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Set it to the production domain on Vercel.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# One of: development | test | production
APP_ENV=development

# =====================================
# Local development only
# =====================================
PORT=3000
