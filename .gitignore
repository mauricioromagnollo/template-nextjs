# Dependencies
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# Testing
#
# Build output directories are anchored with a leading slash so they only match
# at the repository root. An unanchored `site/` would also swallow a legitimate
# `src/config/site/`, and the file would be silently missing from the clone.
/coverage/
.swc

# Playwright (E2E)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Next.js
/.next/
/out/

# Production
/build/
/dist/

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env*
# `!.env*.example` rather than `!.env.example`: a future `.env.staging.example`
# also needs to be committed.
!.env*.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Temporary
/tmp/

# MkDocs build output
/site/

# AI assistant workspaces
.agents
.claude
.cursor
.windsurf
.specs
